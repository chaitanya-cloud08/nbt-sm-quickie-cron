# Copy to .env for local runs (never commit the real .env).

# Anthropic API key used to turn today's articles into 5 GK questions.
ANTHROPIC_API_KEY=

# Google service account JSON, either pasted as-is (single line) or
# base64-encoded (`base64 -w0 service-account.json`).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Google Sheet to append rows to, and the tab name inside it.
SPREADSHEET_ID=
SHEET_NAME=Sheet1
